{
  "name": "simplest-bot",
  "version": "1.0.0",
  "description": "最简单的基于大语言模型的QQ聊天机器人，支持命令系统和插件架构",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts"
  },
  "dependencies": {
    "@langchain/core": "^1.0.0",
    "@langchain/openai": "^1.4.0",
    "better-sqlite3": "^11.10.0",
    "puppeteer-core": "^25.1.0",
    "undici": "^8.4.1",
    "ws": "^8.18.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@google/genai",
      "better-sqlite3",
      "esbuild",
      "protobufjs"
    ]
  },
  "engines": {
    "node": ">=20.0.0"
  }
